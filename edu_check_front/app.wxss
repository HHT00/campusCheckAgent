/* ========================================
   校园考勤助手 — 设计系统
   灵感: Feishu 数据看板 · Notion 排版 · 微信小程序手感
   ======================================== */

/* ---------- 色彩系统 ---------- */
Page {
  --primary: #C0392B;
  --primary-light: #FDE8E8;
  --primary-dark: #962d22;
  --success: #10B981;
  --success-light: #D1FAE5;
  --warning: #F59E0B;
  --warning-light: #FEF3C7;
  --danger: #EF4444;
  --danger-light: #FEE2E2;
  --info: #3B82F6;
  --info-light: #DBEAFE;

  --gray-50: #F9FAFB;
  --gray-100: #F3F4F6;
  --gray-200: #E5E7EB;
  --gray-300: #D1D5DB;
  --gray-400: #9CA3AF;
  --gray-500: #6B7280;
  --gray-600: #4B5563;
  --gray-700: #374151;
  --gray-800: #1F2937;
  --gray-900: #111827;

  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --radius-2xl: 28rpx;

  --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
  --shadow-md: 0 2px 8px rgba(0,0,0,0.06);
  --shadow-lg: 0 4px 16px rgba(0,0,0,0.08);

  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-base: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-2xl: 44rpx;
  --font-3xl: 52rpx;

  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --space-2xl: 40rpx;
}

/* ---------- 基础重置 ---------- */
Page {
  background-color: var(--gray-50);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: var(--gray-900);
  font-size: var(--font-base);
  line-height: 1.6;
  box-sizing: border-box;
}

view, text, image, button, input, textarea {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: inherit;
}
button::after { border: none; }

/* ---------- 页面容器 ---------- */
.page-container {
  padding: var(--space-lg);
  padding-bottom: var(--space-2xl);
  max-width: 750rpx;
  margin: 0 auto;
}

/* ---------- 卡片设计 ---------- */
.card {
  background: #fff;
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.card:active {
  transform: scale(0.99);
}

/* Notion-style 无边框卡片 */
.card-plain {
  background: transparent;
  box-shadow: none;
  padding: 0;
}

/* ---------- 排版 ---------- */
.h1 {
  font-size: var(--font-2xl);
  font-weight: 700;
  color: var(--gray-900);
  line-height: 1.3;
  margin-bottom: var(--space-xs);
}
.h2 {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--gray-800);
  line-height: 1.35;
  margin-bottom: var(--space-xs);
}
.h3 {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--gray-700);
  line-height: 1.4;
}
.body {
  font-size: var(--font-base);
  color: var(--gray-600);
  line-height: 1.6;
}
.caption {
  font-size: var(--font-xs);
  color: var(--gray-400);
  line-height: 1.5;
}

/* 分割标题（Notion style） */
.section-divider {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin: var(--space-xl) 0 var(--space-md) 0;
  color: var(--gray-500);
  font-size: var(--font-sm);
  font-weight: 500;
}
.section-divider::before,
.section-divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--gray-200);
}

/* ---------- 标签（Feishu style） ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  font-size: var(--font-xs);
  font-weight: 500;
  line-height: 1.6;
}
.tag-success {
  background: var(--success-light);
  color: var(--success);
}
.tag-warning {
  background: var(--warning-light);
  color: var(--warning);
}
.tag-danger {
  background: var(--danger-light);
  color: var(--danger);
}
.tag-info {
  background: var(--info-light);
  color: var(--info);
}
.tag-primary {
  background: var(--primary-light);
  color: var(--primary);
}
.tag-default {
  background: var(--gray-100);
  color: var(--gray-500);
}

/* ---------- 状态圆点（Feishu style） ---------- */
.status-dot {
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-right: 6rpx;
}
.status-dot.success { background: var(--success); }
.status-dot.warning { background: var(--warning); }
.status-dot.danger { background: var(--danger); }
.status-dot.info { background: var(--info); }
.status-dot.default { background: var(--gray-300); }

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  border-radius: var(--radius-lg);
  font-size: var(--font-lg);
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: opacity 0.15s;
}
.btn:active { opacity: 0.85; }
.btn-primary {
  background: var(--primary);
  color: #fff;
}
.btn-primary[disabled] {
  opacity: 0.5;
}
.btn-secondary {
  background: #fff;
  border: 2rpx solid var(--gray-200);
  color: var(--gray-700);
}
.btn-danger {
  background: var(--danger-light);
  color: var(--danger);
}

/* ---------- 输入 ---------- */
.input-wrap {
  background: var(--gray-50);
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-md);
  padding: var(--space-md) var(--space-lg);
  font-size: var(--font-base);
  color: var(--gray-800);
  width: 100%;
  transition: border-color 0.15s;
}
.input-wrap:focus {
  border-color: var(--primary);
}

/* ---------- 空状态 ---------- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-2xl) 0;
}
.empty-state text {
  font-size: var(--font-sm);
  color: var(--gray-400);
  margin-top: var(--space-sm);
}

/* ---------- 加载 ---------- */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-2xl) 0;
  color: var(--gray-400);
  font-size: var(--font-sm);
}

/* ---------- 骨架屏 ---------- */
.skeleton {
  background: linear-gradient(90deg, var(--gray-100) 25%, var(--gray-50) 50%, var(--gray-100) 75%);
  background-size: 200% 100%;
  animation: skeleton-wave 1.5s ease-in-out infinite;
  border-radius: var(--radius-md);
}
@keyframes skeleton-wave {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ---------- 动画 ---------- */
.fade-in {
  animation: fadeIn 0.25s ease;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ---------- 列表项 ---------- */
.list-item {
  display: flex;
  align-items: center;
  padding: var(--space-lg);
  gap: var(--space-md);
  border-bottom: 1px solid var(--gray-100);
}
.list-item:last-child {
  border-bottom: none;
}

/* ---------- 徽标 ---------- */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: var(--danger);
  color: #fff;
  font-size: var(--font-xs);
  font-weight: 600;
}

/* ---------- 图标容器 ---------- */
.icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 32rpx;
}

/* ---------- 箭头 ---------- */
.arrow {
  font-size: 32rpx;
  color: var(--gray-300);
  flex-shrink: 0;
}
