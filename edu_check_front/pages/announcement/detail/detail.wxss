.page-container {
  padding: 30rpx;
}
.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
.detail-card {
  padding: 36rpx;
}
.detail-header {
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.header-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.tag-type {
  font-size: 22rpx;
  color: #3498DB;
  background: #EBF0FA;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
}
.tag-top {
  font-size: 22rpx;
  color: #E74C3C;
  background: #FDEDEC;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
}
.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C3E50;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.5;
}
.detail-meta {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #999;
}
.detail-summary {
  background: #FFF8E1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.detail-content {
  font-size: 30rpx;
  color: #2C3E50;
  line-height: 1.8;
}
