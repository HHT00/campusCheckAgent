/* 实习打卡页面样式 */

.page-header {
  margin-bottom: 24rpx;
}

/* 实习信息卡片 */
.intern-card {
  padding: 28rpx;
  background: #fff;
}

.intern-top {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.intern-company-icon {
  width: 72rpx;
  height: 72rpx;
  background: #E8F8F5;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.intern-company-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.company-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 4rpx;
}

.company-role {
  font-size: 24rpx;
  color: #7F8C8D;
}

/* 进度条 */
.intern-progress {
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 20rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 24rpx;
  color: #7F8C8D;
}

.progress-text {
  font-size: 24rpx;
  color: #00B894;
  font-weight: 700;
}

.progress-bar {
  height: 12rpx;
  background: #E8F8F5;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-fill {
  height: 100%;
  background: #00B894;
  border-radius: 6rpx;
  transition: width 0.5s;
}

.progress-detail {
  font-size: 22rpx;
  color: #95A5A6;
}

/* 定位签到 */
.section-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2C3E50;
}

.section-card-status {
  font-size: 24rpx;
  color: #95A5A6;
}

.section-card-status.status-success {
  color: #00B894;
}

.location-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
  border: 2rpx dashed #D5D8DC;
  cursor: pointer;
  transition: all 0.3s;
}

.location-box:active {
  opacity: 0.7;
}

.loc-icon {
  font-size: 56rpx;
}

.detail-addr {
  display: block;
  font-size: 24rpx;
  color: #2C3E50;
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  background: #F0F2F5;
  border-radius: 12rpx;
  word-break: break-all;
}

/* 日志输入 */
.log-textarea {
  width: 100%;
  min-height: 180rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: #2C3E50;
  line-height: 1.6;
  border: none;
}

.log-textarea::placeholder {
  color: #BDC3C7;
}

.log-counter {
  text-align: right;
  font-size: 22rpx;
  color: #BDC3C7;
  margin-top: 8rpx;
}

/* 图片上传 */
.upload-area {
  margin-top: 8rpx;
}

.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-item {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.upload-image {
  width: 100%;
  height: 100%;
}

.upload-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  cursor: pointer;
}

.upload-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F8F9FA;
  border: 2rpx dashed #D5D8DC;
  cursor: pointer;
}

.upload-add:active {
  opacity: 0.7;
}

.add-icon {
  font-size: 48rpx;
  color: #BDC3C7;
  font-weight: 300;
}

/* 打卡按钮 */
.btn-primary {
  margin: 16rpx 0 32rpx;
}

/* 历史记录 */
.history-card {
  padding: 28rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: 700;
}

.history-more {
  font-size: 24rpx;
  color: #3498DB;
}

.history-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  gap: 20rpx;
}

.history-item:last-child {
  border-bottom: none;
}

.history-date-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 72rpx;
}

.history-day {
  font-size: 32rpx;
  font-weight: 800;
  color: #2C3E50;
}

.history-date-text {
  font-size: 20rpx;
  color: #95A5A6;
}

.history-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.history-log {
  font-size: 24rpx;
  color: #555;
  line-height: 1.5;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.history-time {
  font-size: 20rpx;
  color: #BDC3C7;
}

/* 人脸验证卡片 */
.face-card {
  padding: 24rpx;
  border: 2rpx solid #F0F0F0;
}

.face-card-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
}

.face-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2C3E50;
}

.face-card-tip {
  font-size: 22rpx;
  color: #95A5A6;
  margin-top: 4rpx;
}

.face-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #FFF5F5;
  border: 2rpx dashed #E74C3C;
  border-radius: 16rpx;
  cursor: pointer;
}

.face-camera-icon text {
  font-size: 48rpx;
}

.face-action-text {
  font-size: 26rpx;
  color: #E74C3C;
  margin-top: 8rpx;
  font-weight: 600;
}

.face-verifying {
  text-align: center;
  padding: 24rpx;
}

.face-verify-msg {
  font-size: 26rpx;
  color: #3498DB;
}

.face-photo-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.face-photo-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  border: 2rpx solid #E0E0E0;
}

.face-result {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.face-result-text {
  font-size: 26rpx;
  font-weight: 600;
}

.face-result.pass .face-result-text {
  color: #00B894;
}

.face-result.fail .face-result-text {
  color: #E74C3C;
}

.face-retake {
  font-size: 22rpx;
  color: #3498DB;
  margin-top: 4rpx;
  text-decoration: underline;
}
