.page-container {
  padding: 30rpx;
}
.form-card {
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.form-group {
  margin-bottom: 28rpx;
}
.form-label {
  font-size: 28rpx;
  color: #2C3E50;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.input-wrap {
  background: #F5F7FA;
  border-radius: 10rpx;
  padding: 0 24rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
}
.form-input {
  font-size: 28rpx;
  color: #2C3E50;
  flex: 1;
  height: 100%;
}
.form-input::placeholder {
  color: #BDC3C7;
  font-size: 26rpx;
}
.btn-save {
  background: #E74C3C;
  color: #fff;
  font-size: 32rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: none;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}
.btn-save[disabled] {
  opacity: 0.6;
}
