/* ========================================
   首页 — Feishu 数据看板风格
   ======================================== */

/* ---------- 顶部用户卡片 ---------- */
.profile-card {
  display: flex;
  align-items: center;
  padding: var(--space-lg);
  background: linear-gradient(135deg, #C0392B 0%, #E74C3C 100%);
  border-radius: var(--radius-2xl);
  margin-bottom: var(--space-lg);
  color: #fff;
}
.profile-avatar {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,0.4);
  flex-shrink: 0;
}
.profile-avatar .avatar-img {
  width: 100%;
  height: 100%;
}
.avatar-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  font-size: 18rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #fff;
}
.avatar-badge.student { background: var(--info); color: #fff; }
.avatar-badge.teacher { background: var(--warning); color: #fff; }

.profile-info {
  flex: 1;
  margin-left: var(--space-lg);
  min-width: 0;
}
.profile-name {
  font-size: var(--font-xl);
  font-weight: 700;
  color: #fff;
  display: block;
}
.profile-desc {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.75);
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.profile-streak {
  text-align: center;
  padding-left: var(--space-lg);
  border-left: 1px solid rgba(255,255,255,0.25);
}
.streak-num {
  display: block;
  font-size: var(--font-2xl);
  font-weight: 800;
  color: #fff;
  line-height: 1;
}
.streak-label {
  font-size: var(--font-xs);
  color: rgba(255,255,255,0.7);
  margin-top: 4rpx;
  display: block;
}

/* ---------- 指标卡片（Feishu style） ---------- */
.metrics-grid {
  display: flex;
  gap: var(--space-md);
  margin-bottom: var(--space-xs);
}
.metric-card {
  flex: 1;
  background: #fff;
  border-radius: var(--radius-xl);
  padding: var(--space-lg) var(--space-md);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  transition: transform 0.15s, box-shadow 0.15s;
}
.metric-hover {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-md);
}
.metric-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}
.metric-body {
  text-align: center;
}
.metric-value {
  display: block;
  font-size: var(--font-2xl);
  font-weight: 800;
  color: var(--gray-800);
  line-height: 1.2;
}
.metric-label {
  display: block;
  font-size: var(--font-xs);
  color: var(--gray-400);
  margin-top: 2rpx;
}
.metric-trend {
  align-self: flex-end;
}
.trend-up {
  font-size: var(--font-sm);
  color: var(--success);
  font-weight: 700;
}

/* ---------- 任务列表（Feishu Todo style） ---------- */
.task-list {
  background: #fff;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  margin-bottom: var(--space-sm);
}
.task-item {
  display: flex;
  align-items: center;
  padding: var(--space-lg);
  gap: var(--space-md);
  border-bottom: 1px solid var(--gray-100);
  transition: background 0.15s;
}
.task-item:last-child { border-bottom: none; }
.task-item:active { background: var(--gray-50); }
.task-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--gray-300);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: var(--font-sm);
  color: #fff;
  font-weight: 700;
  transition: all 0.2s;
}
.task-check.done {
  background: var(--success);
  border-color: var(--success);
}
.task-body {
  flex: 1;
  min-width: 0;
}
.task-title {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--gray-800);
  display: block;
}
.task-title.done-text {
  color: var(--gray-400);
  text-decoration: line-through;
}
.task-desc {
  font-size: var(--font-xs);
  color: var(--gray-400);
  margin-top: 2rpx;
  display: block;
}
.task-action {
  font-size: var(--font-sm);
  color: var(--primary);
  font-weight: 600;
  flex-shrink: 0;
}

/* ---------- 2列功能网格 ---------- */
.grid-2col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-md);
  margin-bottom: var(--space-xs);
}
.func-card {
  background: #fff;
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  text-align: center;
  transition: transform 0.15s, box-shadow 0.15s;
}
.func-hover {
  transform: scale(0.97);
}
.func-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}
.func-title {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--gray-800);
}
.func-desc {
  font-size: var(--font-xs);
  color: var(--gray-400);
}

/* ---------- 每日思政 ---------- */
.thought-card {
  background: linear-gradient(135deg, #FDF2F2 0%, #FEF5E7 100%);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  margin-top: var(--space-sm);
}
.thought-header {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}
.thought-icon {
  font-size: 28rpx;
}
.thought-label {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--primary);
}
.thought-text {
  font-size: var(--font-sm);
  color: var(--gray-600);
  line-height: 1.8;
}
