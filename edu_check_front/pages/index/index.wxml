<view class="page-container">
  <!-- ===== 顶部用户区域 ===== -->
  <view class="profile-card" bindtap="goProfile">
    <view class="profile-avatar">
      <image src="{{userInfo.avatar || '/images/default_avatar.png'}}" mode="aspectFill" class="avatar-img"></image>
      <view class="avatar-badge {{role === 'teacher' ? 'teacher' : 'student'}}">
        {{role === 'teacher' ? '教' : '学'}}
      </view>
    </view>
    <view class="profile-info">
      <text class="profile-name">{{userInfo.name || '未登录'}}</text>
      <text class="profile-desc">{{userInfo.college || ''}}</text>
    </view>
    <view class="profile-streak">
      <text class="streak-num">{{stats.streakDays || 0}}</text>
      <text class="streak-label">连续打卡</text>
    </view>
  </view>

  <!-- ===== 学生视图 ===== -->
  <block wx:if="{{role !== 'teacher'}}">

    <!-- 三打卡统计（Feishu style metric cards） -->
    <view class="metrics-grid">
      <view class="metric-card" bindtap="goDormHistory" hover-class="metric-hover">
        <view class="metric-icon" style="background: var(--primary-light);">
          <text>🌙</text>
        </view>
        <view class="metric-body">
          <text class="metric-value">{{stats.dormTotal || 0}}</text>
          <text class="metric-label">查寝打卡</text>
        </view>
        <view class="metric-trend">
          <text class="trend-up">↑</text>
        </view>
      </view>
      <view class="metric-card" bindtap="goClassHistory" hover-class="metric-hover">
        <view class="metric-icon" style="background: var(--info-light);">
          <text>📖</text>
        </view>
        <view class="metric-body">
          <text class="metric-value">{{stats.classTotal || 0}}</text>
          <text class="metric-label">上课签到</text>
        </view>
      </view>
      <view class="metric-card" bindtap="goInternHistory" hover-class="metric-hover">
        <view class="metric-icon" style="background: var(--success-light);">
          <text>💼</text>
        </view>
        <view class="metric-body">
          <text class="metric-value">{{stats.internTotal || 0}}</text>
          <text class="metric-label">实习打卡</text>
        </view>
      </view>
    </view>

    <!-- 今日任务（Feishu todo-style） -->
    <view class="section-divider">今日任务</view>

    <view class="task-list">
      <view class="task-item" bindtap="goDormCheckin" hover-class="task-hover">
        <view class="task-check {{stats.todayDorm ? 'done' : ''}}">
          <text wx:if="{{stats.todayDorm}}">✓</text>
        </view>
        <view class="task-body">
          <text class="task-title {{stats.todayDorm ? 'done-text' : ''}}">查寝打卡</text>
          <text class="task-desc">每晚 23:00 前完成归寝打卡</text>
        </view>
        <text class="task-action">{{stats.todayDorm ? '已打卡' : '去打卡'}}</text>
      </view>
      <view class="task-item" bindtap="goClassCheckin" hover-class="task-hover">
        <view class="task-check {{stats.todayClass ? 'done' : ''}}">
          <text wx:if="{{stats.todayClass}}">✓</text>
        </view>
        <view class="task-body">
          <text class="task-title {{stats.todayClass ? 'done-text' : ''}}">上课签到</text>
          <text class="task-desc">课前 10 分钟开启签到窗口</text>
        </view>
        <text class="task-action">{{stats.todayClass ? '已签到' : '去签到'}}</text>
      </view>
      <view class="task-item" bindtap="goInternCheckin" hover-class="task-hover">
        <view class="task-check {{stats.todayIntern ? 'done' : ''}}">
          <text wx:if="{{stats.todayIntern}}">✓</text>
        </view>
        <view class="task-body">
          <text class="task-title {{stats.todayIntern ? 'done-text' : ''}}">实习打卡</text>
          <text class="task-desc">每日实习签到 + 日志上传</text>
        </view>
        <text class="task-action">{{stats.todayIntern ? '已打卡' : '去打卡'}}</text>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="section-divider">全部功能</view>

    <view class="grid-2col">
      <view class="func-card" bindtap="goDormCheckin" hover-class="func-hover">
        <view class="func-icon" style="background: var(--primary-light);">🌙</view>
        <text class="func-title">查寝打卡</text>
        <text class="func-desc">定位·人脸识别</text>
      </view>
      <view class="func-card" bindtap="goClassCheckin" hover-class="func-hover">
        <view class="func-icon" style="background: var(--info-light);">📖</view>
        <text class="func-title">上课签到</text>
        <text class="func-desc">限时·动态码</text>
      </view>
      <view class="func-card" bindtap="goInternCheckin" hover-class="func-hover">
        <view class="func-icon" style="background: var(--success-light);">💼</view>
        <text class="func-title">实习打卡</text>
        <text class="func-desc">定位·日志上报</text>
      </view>
      <view class="func-card" bindtap="goFace" hover-class="func-hover">
        <view class="func-icon" style="background: var(--warning-light);">👤</view>
        <text class="func-title">人脸录入</text>
        <text class="func-desc">百度云AI验证</text>
      </view>
    </view>

  </block>

  <!-- ===== 教师视图 ===== -->
  <block wx:if="{{role === 'teacher'}}">
    <view class="metrics-grid">
      <view class="metric-card" bindtap="goStudents" data-filter="" hover-class="metric-hover">
        <view class="metric-icon" style="background: var(--info-light);">👥</view>
        <view class="metric-body">
          <text class="metric-value">{{stats.totalStudents || 0}}</text>
          <text class="metric-label">学生总数</text>
        </view>
      </view>
      <view class="metric-card" bindtap="goStudents" data-filter="class_not" hover-class="metric-hover">
        <view class="metric-icon" style="background: var(--danger-light);">⚠️</view>
        <view class="metric-body">
          <text class="metric-value" style="color: var(--danger);">{{stats.classNotChecked || 0}}</text>
          <text class="metric-label">未签到</text>
        </view>
      </view>
      <view class="metric-card" bindtap="goStudents" data-filter="dorm_not" hover-class="metric-hover">
        <view class="metric-icon" style="background: var(--warning-light);">🌙</view>
        <view class="metric-body">
          <text class="metric-value" style="color: var(--warning);">{{stats.dormNotChecked || 0}}</text>
          <text class="metric-label">未查寝</text>
        </view>
      </view>
    </view>

    <view class="section-divider">管理后台</view>

    <view class="grid-2col">
      <view class="func-card" bindtap="goTeacherPanel" hover-class="func-hover" style="border: 2rpx solid var(--primary-light);">
        <view class="func-icon" style="background: var(--primary-light);">📊</view>
        <text class="func-title" style="color: var(--primary);">教师工作台</text>
        <text class="func-desc">数据看板·预警·分析</text>
      </view>
      <view class="func-card" bindtap="goAlertCenter" hover-class="func-hover">
        <view class="func-icon" style="background: var(--danger-light);">⚠️</view>
        <text class="func-title">预警中心</text>
        <text class="func-desc">异常考勤检测</text>
      </view>
      <view class="func-card" bindtap="goStudents" hover-class="func-hover">
        <view class="func-icon" style="background: var(--info-light);">👥</view>
        <text class="func-title">学生管理</text>
        <text class="func-desc">查看打卡详情</text>
      </view>
      <view class="func-card" bindtap="goLeaveApprove" hover-class="func-hover">
        <view class="func-icon" style="background: var(--warning-light);">📋</view>
        <text class="func-title">请假审批</text>
        <text class="func-desc">{{stats.pendingLeave || 0}} 条待审批</text>
      </view>
      <view class="func-card" bindtap="goDynamicCode" hover-class="func-hover">
        <view class="func-icon" style="background: var(--success-light);">🔑</view>
        <text class="func-title">动态码</text>
        <text class="func-desc">课堂签到用</text>
      </view>
      <view class="func-card" bindtap="goAnnouncePublish" hover-class="func-hover">
        <view class="func-icon" style="background: var(--primary-light);">📢</view>
        <text class="func-title">公告管理</text>
        <text class="func-desc">发布通知</text>
      </view>
    </view>
  </block>

  <!-- ===== 底部每日思政 ===== -->
  <view class="thought-card">
    <view class="thought-header">
      <text class="thought-icon">💡</text>
      <text class="thought-label">今日思政</text>
    </view>
    <text class="thought-text">广大青年要坚定不移听党话、跟党走，怀抱梦想又脚踏实地，敢想敢为又善作善成。</text>
  </view>
</view>
