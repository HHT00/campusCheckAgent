.schedule-page {
  padding: 16px;
  min-height: 100vh;
}

/* 头部 */
.schedule-header {
  text-align: center;
  padding: 20px 0;
  margin-bottom: 16px;
}

.header-title {
  font-size: 18px;
  font-weight: 700;
  color: #2C3E50;
}

.header-sub {
  font-size: 13px;
  color: #95A5A6;
  margin-top: 6px;
}

/* 课表网格 */
.schedule-grid {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.grid-row {
  display: flex;
  border-bottom: 1px solid #F0F0F0;
}

.grid-row:last-child {
  border-bottom: none;
}

.grid-header {
  background: #F8F9FA;
}

.grid-cell {
  padding: 10px 6px;
  border-right: 1px solid #F0F0F0;
  min-height: 80px;
}

.grid-cell:last-child {
  border-right: none;
}

.cell-time {
  width: 70px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F8F9FA;
}

.time-label {
  font-size: 12px;
  font-weight: 700;
  color: #2C3E50;
}

.time-hour {
  font-size: 10px;
  color: #95A5A6;
  margin-top: 2px;
}

.cell-day {
  flex: 1;
  text-align: center;
}

.day-label {
  font-size: 13px;
  font-weight: 600;
  color: #2C3E50;
}

.cell-class {
  flex: 1;
  padding: 4px;
}

/* 课程卡片 */
.class-card {
  background: #EBF5FB;
  border-radius: 6px;
  padding: 6px 4px;
  margin-bottom: 4px;
  border-left: 3px solid #3498DB;
}

.class-card:last-child {
  margin-bottom: 0;
}

.class-name {
  display: block;
  font-size: 11px;
  font-weight: 600;
  color: #2C3E50;
  line-height: 1.4;
}

.class-teacher {
  display: block;
  font-size: 10px;
  color: #7F8C8D;
  margin-top: 1px;
}

.class-location {
  display: block;
  font-size: 9px;
  color: #95A5A6;
  margin-top: 1px;
}

.no-class {
  text-align: center;
  padding: 20px 0;
  font-size: 14px;
  color: #DDD;
}

/* 统计栏 */
.stats-bar {
  text-align: center;
  padding: 16px 0;
}

.stats-text {
  font-size: 13px;
  color: #BDC3C7;
}

.load-more {
  text-align: center;
  padding: 30px 0;
  font-size: 13px;
  color: #BDC3C7;
}
