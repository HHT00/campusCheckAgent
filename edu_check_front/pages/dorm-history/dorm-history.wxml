<page class="page-container">
  <view class="history-page">
    <!-- 统计摘要 -->
    <view class="summary-bar">
      <text class="summary-text">共 {{total}} 次查寝打卡</text>
    </view>

    <!-- 记录列表 -->
    <view class="record-list">
      <view class="record-item" wx:for="{{recordList}}" wx:key="id">
        <view class="record-left">
          <view class="record-date-box">
            <text class="record-day">{{item.date}}</text>
          </view>
        </view>
        <view class="record-center">
          <text class="record-time">{{item.checkinTime ? item.checkinTime.split(' ')[1] : '-'}}</text>
          <text class="record-addr" wx:if="{{item.locationAddr}}">{{item.locationAddr}}</text>
        </view>
        <text class="tag {{item.status === 'normal' ? 'tag-success' : 'tag-warning'}}">
          {{item.status === 'normal' ? '正常' : '晚归'}}
        </text>
      </view>
    </view>

    <!-- 加载提示 -->
    <view class="load-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="load-more" wx:elif="{{!hasMore && recordList.length > 0}}">
      <text>— 已显示全部记录 —</text>
    </view>
    <view class="load-more" wx:elif="{{!loading && recordList.length === 0}}">
      <text>暂无打卡记录</text>
    </view>

    <!-- 加载更多触发器 -->
    <view class="scroll-trigger" bindtap="loadMore" wx:if="{{hasMore && !loading}}"></view>
  </view>
</page>
