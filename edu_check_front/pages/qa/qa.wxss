.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 20rpx 30rpx 0;
  box-sizing: border-box;
}
.category-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}
.category-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}
.category-tag {
  display: inline-flex;
  padding: 12rpx 28rpx;
  background: #F0F0F0;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
}
.category-tag.active {
  background: #E74C3C;
  color: #fff;
}
.msg-list {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 16rpx;
}
.welcome {
  text-align: center;
  padding: 60rpx 20rpx;
}
.welcome-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}
.welcome-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C3E50;
  display: block;
}
.welcome-desc {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-top: 12rpx;
}
.hot-section {
  margin-top: 40rpx;
  text-align: left;
}
.hot-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E50;
  display: block;
  margin-bottom: 16rpx;
}
.hot-item {
  padding: 20rpx 24rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.hot-item:active {
  opacity: 0.7;
}
.hot-q {
  font-size: 26rpx;
  color: #2C3E50;
}
.msg-row {
  margin-bottom: 24rpx;
  display: flex;
}
.msg-row.ai {
  justify-content: flex-start;
}
.msg-row.user {
  justify-content: flex-end;
}
.msg-bubble {
  max-width: 80%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.msg-row.ai .msg-bubble {
  background: #F0F0F0;
  color: #2C3E50;
  border-bottom-left-radius: 4rpx;
}
.msg-row.user .msg-bubble {
  background: #E74C3C;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}
.msg-content {
  white-space: pre-wrap;
  word-break: break-word;
}
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  flex-shrink: 0;
  border-top: 1rpx solid #f0f0f0;
}
.input-field {
  flex: 1;
  height: 72rpx;
  background: #F5F7FA;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}
.send-btn {
  width: 120rpx;
  height: 72rpx;
  background: #E74C3C;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  flex-shrink: 0;
}
.send-btn[disabled] {
  opacity: 0.5;
}

/* 来源展示 */
.source-section {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0,0,0,0.08);
}
.source-toggle {
  padding: 4rpx 0;
}
.source-toggle-text {
  font-size: 22rpx;
  color: #999;
}
.source-list {
  margin-top: 8rpx;
}
.source-item {
  padding: 10rpx 14rpx;
  background: rgba(0,0,0,0.04);
  border-radius: 8rpx;
  margin-bottom: 6rpx;
}
.source-q {
  font-size: 22rpx;
  color: #666;
}
