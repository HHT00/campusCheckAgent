.history-page {
  padding: 16px;
  min-height: 100vh;
}

.summary-bar {
  padding: 10px 16px;
  background: #F0F2F5;
  border-radius: 8px;
  margin-bottom: 12px;
}

.summary-text {
  font-size: 13px;
  color: #7F8C8D;
}

.record-item {
  display: flex;
  background: #fff;
  border-radius: 10px;
  padding: 14px 16px;
  margin-bottom: 10px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.05);
}

.record-left {
  margin-right: 14px;
  min-width: 50px;
}

.record-day-num {
  font-size: 13px;
  font-weight: 700;
  color: #00B894;
  white-space: nowrap;
}

.record-center {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-date-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.record-date {
  font-size: 13px;
  color: #2C3E50;
  font-weight: 600;
}

.record-time {
  font-size: 12px;
  color: #95A5A6;
}

.record-log {
  font-size: 13px;
  color: #555;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.record-photos {
  display: flex;
  gap: 6px;
  margin-top: 8px;
  flex-wrap: wrap;
}

.record-photo {
  width: 60px;
  height: 60px;
  border-radius: 6px;
  border: 1px solid #F0F0F0;
}

.load-more {
  text-align: center;
  padding: 20px 0;
  font-size: 13px;
  color: #BDC3C7;
}

.scroll-trigger {
  height: 1px;
}
