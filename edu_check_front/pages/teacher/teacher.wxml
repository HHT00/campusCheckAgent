<view class="page-container">
  <!-- 顶部 -->
  <view class="page-header">
    <text class="h1">教师工作台</text>
    <text class="caption">{{currentDate}}</text>
  </view>

  <!-- 今日概览（Feishu metric cards） -->
  <view class="teacher-metrics">
    <view class="t-metric card" bindtap="goStudents" data-filter="" hover-class="t-hover">
      <text class="t-value">{{summary.totalStudents}}</text>
      <text class="t-label">学生总数</text>
    </view>
    <view class="t-metric card" bindtap="goStudents" data-filter="class_checked" hover-class="t-hover">
      <text class="t-value" style="color: var(--success);">{{summary.classChecked}}</text>
      <text class="t-label">已签到</text>
    </view>
    <view class="t-metric card" bindtap="goStudents" data-filter="class_not" hover-class="t-hover">
      <text class="t-value" style="color: var(--danger);">{{summary.classNotChecked}}</text>
      <text class="t-label">未签到</text>
    </view>
    <view class="t-metric card" bindtap="goStudents" data-filter="dorm_not" hover-class="t-hover">
      <text class="t-value" style="color: var(--warning);">{{summary.dormNotChecked}}</text>
      <text class="t-label">未查寝</text>
    </view>
  </view>

  <!-- 预警 -->
  <view class="section-divider">需要关注 <text class="section-more" bindtap="goAlertCenter">查看全部 ›</text></view>
  <view class="alert-stack">
    <view class="alert-row" wx:for="{{alerts}}" wx:key="index" wx:for-item="al">
      <view class="alert-dot {{al.level}}"></view>
      <view class="alert-body">
        <text class="alert-title">{{al.title}}</text>
        <text class="alert-desc">{{al.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 出勤趋势 -->
  <view class="section-divider">本周出勤</view>
  <view class="card trend-card">
    <view class="trend-row" wx:for="{{weekTrend}}" wx:key="day" wx:for-item="d">
      <text class="trend-day">{{d.label}}</text>
      <view class="trend-bar-bg">
        <view class="trend-bar-fill" style="width:{{d.rate}}%; background:{{d.color}};"></view>
      </view>
      <text class="trend-rate">{{d.rate}}%</text>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="section-divider">快捷操作</view>
  <view class="grid-2col">
    <view class="func-card" bindtap="goStudents" hover-class="func-hover">
      <view class="func-icon" style="background: var(--info-light);">👥</view>
      <text class="func-title">学生管理</text>
      <text class="func-desc">查看详情</text>
    </view>
    <view class="func-card" bindtap="goLeaveApprove" hover-class="func-hover">
      <view class="func-icon" style="background: var(--warning-light);">📋</view>
      <text class="func-title">请假审批</text>
      <text class="func-desc">待审批 {{pendingCount}}</text>
    </view>
    <view class="func-card" bindtap="goDynamicCode" hover-class="func-hover">
      <view class="func-icon" style="background: var(--success-light);">🔑</view>
      <text class="func-title">动态码</text>
      <text class="func-desc">课堂签到</text>
    </view>
    <view class="func-card" bindtap="goAnnouncePublish" hover-class="func-hover">
      <view class="func-icon" style="background: var(--primary-light);">📢</view>
      <text class="func-title">公告</text>
      <text class="func-desc">发布通知</text>
    </view>
  </view>

  <!-- 数据分析排行 -->
  <view class="section-divider">数据分析</view>

  <view class="card analysis-card" wx:if="{{courseRanking.length > 0}}">
    <view class="analysis-header">
      <text class="analysis-title">课程出勤率排行 (近30天)</text>
    </view>
    <view class="analysis-row" wx:for="{{courseRanking}}" wx:key="index" wx:for-item="cr">
      <view class="analysis-rank">{{index + 1}}</view>
      <view class="analysis-body">
        <text class="analysis-name">{{cr.name}}</text>
        <view class="analysis-bar-bg">
          <view class="analysis-bar-fill" style="width:{{cr.rate}}%; background:{{cr.rate >= 80 ? 'var(--success)' : (cr.rate >= 60 ? 'var(--warning)' : 'var(--danger)')}};"></view>
        </view>
      </view>
      <text class="analysis-rate {{cr.rate >= 80 ? 'text-success' : (cr.rate >= 60 ? 'text-warning' : 'text-danger')}}">{{cr.rate}}%</text>
    </view>
  </view>

  <view class="card analysis-card" wx:if="{{dormRanking.length > 0}}">
    <view class="analysis-header">
      <text class="analysis-title">🏠 近7天晚归宿舍排行</text>
    </view>
    <view class="analysis-row" wx:for="{{dormRanking}}" wx:key="index" wx:for-item="dr">
      <text class="analysis-rank">{{index + 1}}</text>
      <text class="analysis-name">{{dr.building}}</text>
      <text class="analysis-rate text-warning">{{dr.late_count}} 次</text>
    </view>
  </view>

  <view class="card analysis-card" wx:if="{{leaveAnomaly.length > 0}}">
    <view class="analysis-header">
      <text class="analysis-title">📋 请假模式异常</text>
    </view>
    <view class="analysis-row" wx:for="{{leaveAnomaly}}" wx:key="index" wx:for-item="la">
      <text class="analysis-rank">{{index + 1}}</text>
      <view class="analysis-body">
        <text class="analysis-name">{{la.name}}</text>
        <text class="analysis-desc">请假 {{la.total_leaves}} 次 · 周一病假 {{la.monday_sick}} 次</text>
      </view>
      <text class="analysis-rate text-danger">{{la.monday_ratio}}%</text>
    </view>
  </view>

  <!-- 同步 + 导出 -->
  <view class="export-bar" bindtap="triggerSync">
    <text class="export-icon">🔄</text>
    <text class="export-text">立即同步数据</text>
    <text class="export-sub">{{syncStatus}}</text>
  </view>
  <view class="export-bar" style="margin-top:16rpx;" bindtap="exportSummary">
    <text class="export-icon">📥</text>
    <text class="export-text">导出今日概览数据</text>
  </view>
</view>
