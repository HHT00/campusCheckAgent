.page-container {
  padding: 30rpx;
}
.section {
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.form-group {
  margin-bottom: 0;
}
.form-label {
  font-size: 28rpx;
  color: #2C3E50;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.picker-value {
  background: #F5F7FA;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #2C3E50;
}
.picker-value.placeholder {
  color: #999;
}
.btn-generate {
  background: #E74C3C;
  color: #fff;
  font-size: 32rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  border: none;
  text-align: center;
}
.btn-generate.loading {
  opacity: 0.7;
}
.code-card {
  padding: 40rpx;
  text-align: center;
  margin-bottom: 24rpx;
}
.code-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}
.code-display {
  background: #F5F7FA;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #00B894;
}
.code-display.expired {
  border-color: #E74C3C;
  opacity: 0.6;
}
.code-text {
  font-size: 80rpx;
  font-weight: 800;
  letter-spacing: 16rpx;
  color: #2C3E50;
  font-family: 'Courier New', monospace;
}
.code-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.code-session, .code-course {
  font-size: 24rpx;
  color: #999;
}
.code-countdown {
  margin-bottom: 20rpx;
}
.countdown-text {
  font-size: 32rpx;
  font-weight: 600;
}
.text-success { color: #00B894; }
.text-danger { color: #E74C3C; }
.code-actions {
  margin-top: 20rpx;
}
.btn-refresh {
  background: #3498DB;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 10rpx;
  border: none;
  display: inline-block;
}
.help-card {
  padding: 30rpx;
}
.help-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 16rpx;
}
.help-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}
