.page-container {
  padding: 30rpx;
}
.page-header {
  margin-bottom: 24rpx;
}
.page-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C3E50;
  display: block;
}
.page-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}
.page-export {
  font-size: 24rpx;
  color: #3498DB;
  flex-shrink: 0;
  padding: 10rpx;
}
.page-export:active {
  opacity: 0.7;
}
.loading, .empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.item {
  padding: 24rpx;
}
.item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.item-q {
  flex: 1;
  font-size: 28rpx;
  color: #2C3E50;
  font-weight: 500;
}
.item-cat {
  font-size: 22rpx;
  color: #3498DB;
  background: #EBF0FA;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.item-time {
  font-size: 22rpx;
  color: #999;
}
