.page-container {
  padding: 30rpx;
}
.stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.stat-item {
  flex: 1;
  padding: 24rpx;
  text-align: center;
}
.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}
.stat-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  padding-bottom: 10rpx;
}
.filter-tag {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: #F0F0F0;
  color: #666;
  white-space: nowrap;
}
.filter-tag.active {
  background: #E74C3C;
  color: #fff;
}
.loading, .empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
.leave-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.leave-item {
  padding: 24rpx;
}
.leave-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.leave-id {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}
.leave-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.leave-student {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
}
.leave-student-id {
  font-size: 22rpx;
  color: #999;
  margin-left: 12rpx;
}
.leave-status {
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.leave-status.pending {
  background: #FFF3E0;
  color: #F39C12;
}
.leave-status.approved {
  background: #E8F5E9;
  color: #00B894;
}
.leave-status.rejected {
  background: #FFEBEE;
  color: #E74C3C;
}
.leave-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.leave-type {
  font-size: 26rpx;
  color: #2C3E50;
}
.leave-days {
  font-size: 24rpx;
  color: #666;
}
.leave-reason {
  font-size: 24rpx;
  color: #666;
}
.leave-reject {
  font-size: 24rpx;
  color: #E74C3C;
}
.leave-time {
  font-size: 22rpx;
  color: #999;
}
.leave-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}
.btn-approve {
  flex: 1;
  background: #00B894;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx;
  text-align: center;
  border-radius: 10rpx;
  border: none;
}
.btn-reject {
  flex: 1;
  background: #E74C3C;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx;
  text-align: center;
  border-radius: 10rpx;
  border: none;
}
