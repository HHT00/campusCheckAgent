.page-container {
  padding: 30rpx;
}
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.toolbar-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E50;
}
.btn-create {
  background: #E74C3C;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
  border: none;
  line-height: 1.4;
}
.loading, .empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
.announce-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.announce-item {
  padding: 24rpx;
}
.announce-header {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.announce-type {
  font-size: 22rpx;
  color: #3498DB;
  background: #E8F4FD;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.announce-top {
  font-size: 22rpx;
  color: #E74C3C;
  background: #FFEBEE;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.announce-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
  display: block;
  margin-bottom: 8rpx;
}
.announce-summary {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.5;
}
.announce-footer {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
}
.announce-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.action-edit {
  font-size: 26rpx;
  color: #3498DB;
}
.action-delete {
  font-size: 26rpx;
  color: #E74C3C;
}
/* Form Modal */
.form-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: none;
}
.form-overlay.show {
  display: flex;
  align-items: flex-end;
}
.form-modal {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  width: 100%;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}
.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E50;
}
.form-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}
.form-body {
  padding: 30rpx;
  max-height: 60vh;
}
.form-group {
  margin-bottom: 28rpx;
}
.form-label {
  font-size: 28rpx;
  color: #2C3E50;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.input-wrap {
  background: #F5F7FA;
  border-radius: 10rpx;
  padding: 0 24rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
}
.form-input {
  font-size: 28rpx;
  color: #2C3E50;
  flex: 1;
  height: 100%;
}
.textarea-wrap {
  background: #F5F7FA;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
}
.form-textarea {
  font-size: 28rpx;
  color: #2C3E50;
  width: 100%;
  height: 120rpx;
}
.form-textarea.large {
  height: 240rpx;
}
.form-switch-group {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.picker-value {
  background: #F5F7FA;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #2C3E50;
}
.form-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}
.btn-cancel {
  flex: 1;
  background: #f0f0f0;
  color: #666;
  font-size: 28rpx;
  padding: 20rpx;
  text-align: center;
  border-radius: 10rpx;
  border: none;
}
.btn-submit {
  flex: 2;
  background: #E74C3C;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx;
  text-align: center;
  border-radius: 10rpx;
  border: none;
}
.btn-submit[disabled] {
  opacity: 0.6;
}
