.page-container {
  padding: 30rpx;
}
.loading, .empty-row {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* ====== 风险卡片 ====== */
.risk-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #FFF5F5;
  border: 2rpx solid #FFCCCC;
}
.risk-left {
  width: 6rpx;
  height: 48rpx;
  border-radius: 3rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.risk-left.warn { background: #E74C3C; }
.risk-left.info { background: #F39C12; }
.risk-body {
  flex: 1;
}
.risk-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #C0392B;
  display: block;
}
.risk-desc {
  font-size: 24rpx;
  color: #E74C3C;
  margin-top: 4rpx;
  display: block;
}

/* ====== 学生基本信息 ====== */
.student-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.student-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 24rpx;
}
.student-avatar image {
  width: 100%;
  height: 100%;
}
.student-info {
  flex: 1;
}
.student-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C3E50;
}
.student-id-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin: 6rpx 0;
}
.student-college {
  font-size: 24rpx;
  color: #666;
}

/* ====== 统计行 ====== */
.stats-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.stat-item {
  padding: 20rpx;
  text-align: center;
  border-left: 4rpx solid #3498DB;
  margin-bottom: 0;
}
.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2C3E50;
}
.stat-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* ====== 趋势图 ====== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 0 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
}
.section-action {
  font-size: 24rpx;
  color: #3498DB;
}
.section-action:active {
  opacity: 0.7;
}
.trend-card {
  padding: 20rpx 24rpx;
}
.trend-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.trend-row:last-child {
  margin-bottom: 0;
}
.trend-day {
  width: 80rpx;
  font-size: 22rpx;
  color: #666;
  flex-shrink: 0;
}
.trend-bar-wrap {
  flex: 1;
  height: 28rpx;
  background: #F0F0F0;
  border-radius: 14rpx;
  margin: 0 16rpx;
  overflow: hidden;
}
.trend-bar {
  height: 100%;
  border-radius: 14rpx;
  min-width: 4rpx;
  transition: width 0.3s;
}
.trend-bar.success { background: #00B894; }
.trend-bar.warning { background: #F39C12; }
.trend-bar.danger { background: #E74C3C; }
.trend-bar.default { background: #E0E0E0; }
.trend-status {
  width: 70rpx;
  font-size: 22rpx;
  text-align: right;
  flex-shrink: 0;
}
.trend-status.success { color: #00B894; }
.trend-status.warning { color: #F39C12; }
.trend-status.danger { color: #E74C3C; }
.trend-status.default { color: #999; }

/* ====== 签到卡片 ====== */
.checkin-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}
.checkin-status {
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.status-present {
  background: #E8F5E9;
  color: #00B894;
}
.status-late {
  background: #FFF3E0;
  color: #F39C12;
}
.status-absent {
  background: #FFEBEE;
  color: #E74C3C;
}
.checkin-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 24rpx;
  color: #666;
}

/* ====== 记录列表 ====== */
.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}
.record-date {
  flex: 1;
  font-size: 26rpx;
  color: #2C3E50;
}
.record-status {
  font-size: 24rpx;
  font-weight: 500;
  margin: 0 20rpx;
}
.record-time {
  font-size: 24rpx;
  color: #999;
}
.text-success { color: #00B894; }
.text-warning { color: #F39C12; }
.text-danger { color: #E74C3C; }
