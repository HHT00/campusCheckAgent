# ============================================
# 校园考勤助手 - 配置文件模板
# 复制为 application.yml 并填入实际值
# cp application.yml.template application.yml
# ============================================

server:
  port: 8080

spring:
  application:
    name: edu-check-backend
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/cs_edu0717?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: ${MYSQL_PASSWORD:your_password_here}
    hikari:
      minimum-idle: 5
      maximum-pool-size: 20
      idle-timeout: 300000
      max-lifetime: 1200000
      connection-timeout: 30000
  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: Asia/Shanghai
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 50MB

mybatis-plus:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.educheck.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

jwt:
  secret: ${JWT_SECRET:edu-check-secret-key-change-me-in-production}
  expiration: 86400000

face:
  upload-dir: uploads/face

deepseek:
  api-key: ${DEEPSEEK_API_KEY:your_deepseek_api_key}
  base-url: https://api.deepseek.com
  model: deepseek-chat
  temperature: 0.3
  max-tokens: 512

baidu-cloud:
  app-id: ${BAIDU_APP_ID:your_baidu_app_id}
  api-key: ${BAIDU_API_KEY:your_baidu_api_key}
  secret-key: ${BAIDU_SECRET_KEY:your_baidu_secret_key}
  face:
    score-threshold: 80

springdoc:
  swagger-ui:
    path: /swagger-ui.html
  api-docs:
    path: /v3/api-docs

knife4j:
  enable: true
  setting:
    language: zh-CN
